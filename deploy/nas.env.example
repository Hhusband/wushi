# 吾师 — NAS 连接配置（模板）
#
# 使用方法：
#   cp deploy/nas.env.example deploy/nas.env
#   然后填入真实的 NAS 密码 / SSH 私钥路径（nas.env 已被 .gitignore 排除，不会入库）
#
# 部署脚本会自动 source 本文件，也可用同名环境变量临时覆盖。

NAS_HOST=10.200.223.1
NAS_USER=admin-01
# 仅用于远程 sudo 提权（docker 命令需要 root）；SSH 登录本身走密钥
NAS_PASS=填你的密码
NAS_DIR=/volume1/docker/classroom-ai
NAS_PORT=22

# SSH 私钥（首次配置见 deploy/README.md）
NAS_KEY="$HOME/.ssh/wushi_nas_ed25519"

# DSM 7 上 docker / docker-compose 的绝对路径（不在默认 PATH 中）
NAS_DOCKER=/var/packages/ContainerManager/target/usr/bin/docker
NAS_COMPOSE=/var/packages/ContainerManager/target/usr/bin/docker-compose
NAS_CONTAINER=classroom-ai-app-1

# 应用对外地址
APP_URL=http://10.200.223.1:3003
APP_PORT=3003
NAS_IMAGE=classroom-ai-app:latest
